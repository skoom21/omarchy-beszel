#!/usr/bin/env python3
"""Emit a one-line JSON summary of a Beszel hub for the Omarchy bar widget.

Configuration is resolved per key: the credentials file is the base, then
non-secret values from the environment, then secrets from stdin. So a user can
put the hub URL in plugin settings while keeping the password out of
shell.json.

  stdin                one JSON object: {"url","email","password"} -- secrets
                       travel here because /proc/<pid>/environ is readable by
                       any same-user process for the lifetime of this one
  BESZEL_URL / BESZEL_EMAIL         non-secret, environment is fine
  $BESZEL_CONFIG or ~/.config/beszel-status/config   key=value, mode 0600

Always exits 0 and always prints valid JSON, so the bar never has to parse
failure. Use --check for a human-readable exit-code test instead.

Stdlib only, so it runs anywhere Omarchy does.
"""
import hashlib
import json
import os
import select
import stat
import sys
import urllib.error
import urllib.request

DEFAULT_CONFIG = os.path.expanduser("~/.config/beszel-status/config")
THEME_COLORS = os.path.expanduser(
    "~/.local/state/omarchy/current/theme/colors.toml")
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "omarchy-beszel")
TIMEOUT = 5
MAX_BYTES = 4 * 1024 * 1024
MAX_FILE_BYTES = 256 * 1024
STDIN_WAIT = 2.0
FALLBACK_RED = "#de6145"


class _NoRedirects(urllib.request.HTTPRedirectHandler):
    """Refuse every redirect.

    urllib replays the Authorization header on a cross-origin redirect, so a
    hostile or compromised hub could bounce an authenticated request to a host
    it controls and harvest the session token. A Beszel API endpoint has no
    legitimate reason to redirect, so treat one as an error.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.URLError(f"refused redirect to {newurl}")


_OPENER = urllib.request.build_opener(_NoRedirects)


# --------------------------------------------------------------- theme colour

def _lum(hexstr):
    h = str(hexstr).lstrip("#")
    if len(h) != 6:
        return None
    try:
        r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except ValueError:
        return None
    f = lambda c: c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def _contrast(a, b):
    la, lb = _lum(a), _lum(b)
    if la is None or lb is None:
        return 0
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def alert_color():
    """The active Omarchy theme's most legible red against the bar background.

    Omarchy maps the shell's `urgent` role from the theme's plain `red`, which
    in some themes is a near-grey that reads as "disabled" rather than "alert".
    And `bright_red` is an ANSI slot name, not a luminance promise -- some
    themes make it the darker of the two. So read the candidates plus the
    background and keep whichever actually contrasts. Re-read every poll so the
    colour follows theme changes without a restart.
    """
    keys = {}
    try:
        with open(THEME_COLORS) as fh:
            for line in fh:
                line = line.strip()
                if "=" not in line or line.startswith("#"):
                    continue
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip().strip("\"'")
                if k in ("red", "bright_red", "orange", "background"):
                    keys.setdefault(k, v)
    except OSError:
        return FALLBACK_RED

    bg = keys.get("background", "#121212")
    candidates = [keys[k] for k in ("red", "bright_red", "orange") if k in keys]
    if not candidates:
        return FALLBACK_RED
    best = max(candidates, key=lambda c: _contrast(c, bg))
    return best if _contrast(best, bg) >= 3.0 else FALLBACK_RED


# -------------------------------------------------------------- configuration

def _open_private(path, flags, mode=0o600):
    """Open a path we expect to own, refusing symlinks and foreign files.

    O_NOFOLLOW stops a symlink planted at a predictable path from redirecting a
    read or a token write somewhere else, and the fstat check refuses anything
    that is not a regular file we own -- both verified after the fd exists, so
    there is no TOCTOU gap between the check and the use.
    """
    fd = os.open(path, flags | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), mode)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise PermissionError(f"not a regular file: {path}")
        if st.st_uid != os.getuid():
            raise PermissionError(f"not owned by this user: {path}")
    except Exception:
        os.close(fd)
        raise
    return fd


def read_config_file(path):
    """Parse a key=value credentials file, bounded and symlink-safe."""
    cfg = {}
    try:
        fd = _open_private(path, os.O_RDONLY)
    except OSError:
        return cfg
    try:
        with os.fdopen(fd, "r", errors="replace") as fh:
            # Read a bounded prefix so an oversized file is never materialized.
            blob = fh.read(MAX_FILE_BYTES)
        for line in blob.splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip()
    except OSError:
        pass
    return cfg


def _open_dir_private(path, create=False):
    """Open a directory we own, refusing symlinks."""
    cloexec = getattr(os, "O_CLOEXEC", 0)
    if create:
        try:
            os.mkdir(path, 0o700)
        except FileExistsError:
            pass
    dfd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | cloexec)
    try:
        st = os.fstat(dfd)
        if not stat.S_ISDIR(st.st_mode):
            raise PermissionError(f"not a directory: {path}")
        if st.st_uid != os.getuid():
            raise PermissionError(f"not owned by this user: {path}")
        os.fchmod(dfd, 0o700)
    except Exception:
        os.close(dfd)
        raise
    return dfd


def _atomic_write_private(dfd, name, content):
    """Replace `name` under `dfd` atomically, never truncating the destination.

    O_NOFOLLOW refuses a symlink but not a same-owner *hard link*, and opening
    the destination O_TRUNC would already have destroyed whatever that link
    points at before any fstat could reject it. So the destination is never
    opened for writing: a fresh O_EXCL temporary is created under the verified
    directory descriptor -- O_EXCL guarantees a brand-new inode with no
    pre-existing links -- and renamed into place, which is atomic, so a reader
    sees either the old file or the complete new one and never a partial write.
    """
    cloexec = getattr(os, "O_CLOEXEC", 0)
    tmp = f".{name}.{os.getpid()}.{os.urandom(6).hex()}.tmp"
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY | cloexec, 0o600,
                 dir_fd=dfd)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
            fh.flush()
            os.fsync(fh.fileno())
        os.rename(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
    except Exception:
        try:
            os.unlink(tmp, dir_fd=dfd)
        except OSError:
            pass
        raise


def write_config(path, values):
    """Write the credentials file without ever following a symlink.

    Shell redirection cannot do this safely: `mkdir -p`, `chmod`, and `>file`
    all follow a symlink standing in for the directory or the file, which would
    redirect a password-bearing truncation somewhere else. Everything here goes
    through openat() against a directory descriptor opened O_NOFOLLOW, with the
    regular-file and ownership checks made on the descriptors themselves, so no
    path is ever re-resolved between the check and the write.
    """
    parent = os.path.dirname(path) or "."
    name = os.path.basename(path)
    cloexec = getattr(os, "O_CLOEXEC", 0)

    dfd = _open_dir_private(parent, create=True)
    try:
        # Keep any label.* lines the user added by hand. Reading is
        # non-destructive, so a check-after-open is sufficient here.
        labels = []
        try:
            rfd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | cloexec, dir_fd=dfd)
            with os.fdopen(rfd, "r", errors="replace") as fh:
                for line in fh.read(MAX_FILE_BYTES).splitlines():
                    if line.strip().startswith("label."):
                        labels.append(line.rstrip())
        except OSError:
            pass

        body = [
            "# Credentials for the Omarchy Beszel widget. Keep this file private.",
            f"url={values.get('url', '')}",
            f"email={values.get('email', '')}",
            f"password={values.get('password', '')}",
            "",
            "# Optional: a subtitle shown under a server's name in the panel.",
            "# The key must match the system name as it appears in Beszel.",
            "# label.my-server=Hetzner \u00b7 10.0.0.1",
        ] + labels
        _atomic_write_private(dfd, name, "\n".join(body) + "\n")
    finally:
        os.close(dfd)


def read_stdin_secrets():
    """Secrets handed over on stdin by the panel, one JSON object per run.

    The environment is not a safe channel: /proc/<pid>/environ is readable by
    any process running as the same user for as long as this one lives. stdin
    is private to the pipe. A short select() guard keeps a run that is given no
    input -- a shell invocation, say -- from blocking forever.
    """
    try:
        if sys.stdin is None or sys.stdin.closed or sys.stdin.isatty():
            return {}
        if not select.select([sys.stdin], [], [], STDIN_WAIT)[0]:
            return {}
        raw = sys.stdin.readline(MAX_FILE_BYTES).strip()
    except (OSError, ValueError):
        return {}
    if not raw:
        return {}
    try:
        payload = json.loads(raw)
    except ValueError:
        return {}
    if not isinstance(payload, dict):
        return {}
    return {k: str(v) for k, v in payload.items()
            if k in ("url", "email", "password") and v}


def resolve_config():
    """Merge config sources, most trusted last.

    The credentials file is the base. Non-secret values may come from the
    environment. Secrets arrive only on stdin or from the file -- never the
    environment, which is world-readable to same-user processes.
    """
    path = os.path.expanduser(os.environ.get("BESZEL_CONFIG") or DEFAULT_CONFIG)
    cfg = read_config_file(path)

    for env_key, cfg_key in (("BESZEL_URL", "url"), ("BESZEL_EMAIL", "email")):
        value = os.environ.get(env_key, "").strip()
        if value:
            cfg[cfg_key] = value

    cfg.update(read_stdin_secrets())

    cfg.setdefault("url", "http://localhost:8090")
    cfg["_configPath"] = path
    return cfg


def missing_fields(cfg):
    return [k for k in ("url", "email", "password") if not cfg.get(k)]


# ------------------------------------------------------------------- hub calls

def cache_path(cfg):
    key = hashlib.sha256(
        f"{cfg.get('url','')}|{cfg.get('email','')}".encode()).hexdigest()[:16]
    return os.path.join(CACHE_DIR, f"token-{key}")


def call(base, path, token=None, data=None):
    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = token
    req = urllib.request.Request(
        base.rstrip("/") + path,
        headers=headers,
        data=json.dumps(data).encode() if data else None,
        method="POST" if data else "GET",
    )
    with _OPENER.open(req, timeout=TIMEOUT) as r:
        raw = r.read(MAX_BYTES + 1)
    if len(raw) > MAX_BYTES:
        raise ValueError("hub response too large")
    return json.loads(raw)


def authenticate(cfg):
    res = call(cfg["url"], "/api/collections/users/auth-with-password",
               data={"identity": cfg["email"], "password": cfg["password"]})
    token = res["token"]
    try:
        # Same hazard as the credentials file: the cache path is predictable, so
        # the destination is never opened for writing -- O_TRUNC would destroy
        # whatever a planted hard link points at before any check could reject
        # it. A fresh O_EXCL temporary is renamed into place instead.
        dfd = _open_dir_private(CACHE_DIR, create=True)
        try:
            _atomic_write_private(dfd, os.path.basename(cache_path(cfg)), token)
        finally:
            os.close(dfd)
    except OSError:
        pass  # A cache we cannot write just means re-authenticating each poll.
    return token


def fetch(cfg, force_auth=False):
    """Try the cached token first; re-authenticate once if it has expired.

    force_auth skips the cache entirely. --check and --write-config must
    actually exercise the password: the cache is keyed on url+email, so a stale
    entry would otherwise let a wrong password report success and be saved,
    only to fail confusingly once the token expired.
    """
    token = None
    if not force_auth:
        try:
            fd = _open_private(cache_path(cfg), os.O_RDONLY)
            with os.fdopen(fd, "r", errors="replace") as fh:
                token = fh.read(MAX_FILE_BYTES).strip()
        except OSError:
            pass

    for attempt in (0, 1):
        if not token:
            token = authenticate(cfg)
        try:
            systems = call(cfg["url"],
                           "/api/collections/systems/records?perPage=200",
                           token)["items"]
            alerts = call(
                cfg["url"],
                "/api/collections/alerts/records?perPage=200&filter=(triggered=true)",
                token)["items"]
            return systems, alerts
        except urllib.error.HTTPError as e:
            if e.code in (401, 403) and attempt == 0:
                token = None
                continue
            raise
    raise RuntimeError("unreachable")


# ----------------------------------------------------------------- formatting

def fmt_uptime(secs):
    try:
        secs = int(secs)
    except (TypeError, ValueError):
        return ""
    d, rem = divmod(secs, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m}m"
    return f"{m}m"


def friendly_error(e):
    if isinstance(e, urllib.error.HTTPError):
        if e.code in (400, 401, 403):
            return "Hub rejected those credentials"
        return f"Hub returned HTTP {e.code}"
    if isinstance(e, urllib.error.URLError):
        return f"Cannot reach hub ({e.reason})"
    if isinstance(e, (KeyError, ValueError, TypeError)):
        return "Hub returned an unexpected response"
    return str(e) or e.__class__.__name__


def emit(payload):
    print(json.dumps(payload))


def base_payload(cfg, **extra):
    payload = {
        "configured": False, "ok": False,
        "up": 0, "total": 0, "alerts": 0,
        "label": "—", "badge": "", "summary": "",
        "alertColor": alert_color(),
        "hubUrl": cfg.get("url", ""),
        "configPath": cfg.get("_configPath", DEFAULT_CONFIG),
        "systems": [], "firing": [], "error": "",
    }
    payload.update(extra)
    return payload


# ----------------------------------------------------------------------- main

def build(cfg, force_auth=False):
    systems, alerts = fetch(cfg, force_auth=force_auth)

    total = len(systems)
    up = sum(1 for s in systems if s.get("status") == "up")
    firing_by_system = {}
    for a in alerts:
        firing_by_system.setdefault(a.get("system"), []).append(a.get("name", "?"))
    firing = len(alerts)

    rows = []
    for s in sorted(systems, key=lambda x: str(x.get("name", ""))):
        info = s.get("info") or {}
        name = s.get("name", "?")
        la = info.get("la") or []
        rows.append({
            "name": name,
            "status": s.get("status", "?"),
            "label": cfg.get(f"label.{name}", ""),
            "cpu": round(float(info.get("cpu") or 0), 1),
            "mem": round(float(info.get("mp") or 0), 1),
            "disk": round(float(info.get("dp") or 0), 1),
            "cores": info.get("t") or 0,
            "load": "  ".join(f"{float(x):.2f}" for x in la) if la else "",
            "uptime": fmt_uptime(info.get("u")),
            "agent": info.get("v") or "",
            "firing": sorted(firing_by_system.get(s.get("id"), [])),
        })

    # `badge` sits in the hero's fixed-width pill next to the title, so it has
    # to stay short -- a long string there elides the title itself down to "...".
    # `summary` carries the full sentence for the tooltip and problem section.
    if total == 0:
        badge = summary = "No systems"
    elif up == total and firing == 0:
        badge = summary = "All healthy"
    elif firing:
        badge = f"{firing} alert{'s' if firing != 1 else ''}"
        summary = f"{firing} alert{'s' if firing != 1 else ''} firing"
    else:
        badge = summary = f"{total - up} down"

    return base_payload(
        cfg,
        configured=True,
        ok=(total > 0 and up == total and firing == 0),
        up=up, total=total, alerts=firing,
        label=f"{up}/{total}" if not firing else f"{up}/{total} !{firing}",
        badge=badge,
        summary=summary,
        systems=rows,
        firing=[{"system": r["name"], "types": r["firing"]}
                for r in rows if r["firing"]],
    )


def main():
    args = sys.argv[1:]
    check = "--check" in args
    write = "--write-config" in args
    cfg = resolve_config()

    missing = missing_fields(cfg)
    if missing:
        message = "Not configured — missing " + ", ".join(missing)
        if check or write:
            print(message, file=sys.stderr)
            return 1
        emit(base_payload(cfg, label="setup", badge="Setup needed",
                          summary=message, error="unconfigured"))
        return 0

    try:
        payload = build(cfg, force_auth=(check or write))
    except Exception as e:  # noqa: BLE001 - any failure must still render
        message = friendly_error(e)
        if check or write:
            print(message, file=sys.stderr)
            return 1
        badge = ("Auth failed" if "credentials" in message
                 else "Unreachable" if "reach" in message else "Error")
        emit(base_payload(cfg, configured=True, label="!", badge=badge,
                          summary=message, error=message))
        return 0

    if write:
        # Only persist credentials the hub has just accepted.
        try:
            write_config(cfg["_configPath"], cfg)
        except OSError as e:
            print(f"Refusing to write {cfg['_configPath']}: {e}", file=sys.stderr)
            return 1
        print(f"Connected to {cfg['url']} — {payload['up']}/{payload['total']} up")
        print(f"Wrote {cfg['_configPath']} (0600)")
        return 0

    if check:
        print(f"Connected to {cfg['url']} — {payload['up']}/{payload['total']} up")
        return 0
    emit(payload)
    return 0


if __name__ == "__main__":
    sys.exit(main())
